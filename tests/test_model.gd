extends SceneTree
const Model = preload("res://model.gd")
func _initialize() -> void:
	var a = Model.new()
	a.reset(20261028, false)
	assert(a.day == 1 and a.profit == 0)
	assert(a.event_index() == a.event_index())
	var first = a.trade([2, 3, 4], [6, 5, 4])
	assert(first.size() == 3)
	for row in first:
		assert(row.sold + row.waste == row.stock)
		assert(row.sold == mini(row.stock, row.demand))
		assert(row.revenue == row.sold * row.price)
		assert(row.demand >= 0)
	a.advance()
	assert(a.day == 2)
	var b = Model.new()
	b.reset(20261028, false)
	assert(first == b.trade([2, 3, 4], [6, 5, 4]))
	var lower = Model.new()
	lower.reset(20261028, false)
	var cheap = lower.trade([1, 1, 1], [8, 8, 8])
	var high = Model.new()
	high.reset(20261028, false)
	var costly = high.trade([5, 5, 5], [8, 8, 8])
	for i in 3:
		assert(cheap[i].demand > costly[i].demand)
	assert(Model.elasticity(5) < Model.elasticity(1))
	var zero = Model.new()
	zero.reset(3, true)
	var empty = zero.trade([1, 1, 1], [0, 0, 0])
	for row in empty:
		assert(row.sold == 0 and row.waste == 0)
	for d in range(2, 8):
		zero.advance()
		zero.trade([1, 1, 1], [0, 0, 0])
	assert(zero.failed())
	print("MODEL_TEST_PASS deterministic, conservation, price elasticity, zero stock, bankruptcy")
	quit()
